---
import '../styles/global.css';import Header from '../components/Header.astro';import Footer from '../components/Footer.astro';
import {canonicalPagePath} from '../lib/routing';
import {site} from '../data/site';import {artistSchema,websiteSchema,absolute,jsonLd} from '../lib/structured';
interface Props {title:string;description?:string;image?:string;schema?:unknown[];noindex?:boolean;markdown?:string;}
const {title,description=site.description,image=site.image,schema=[],noindex=false,markdown}=Astro.props;
const path=canonicalPagePath(Astro.url.pathname);const canonical=absolute(path);const graph=[artistSchema,websiteSchema,{'@type':'WebPage','@id':canonical+'#page',url:canonical,name:title,description,isPartOf:{'@id':absolute('/#website')},about:{'@id':absolute('/#artist')}},...(path!=='/'?[{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:site.origin},...(path.startsWith('/music/')&&path!=='/music/'?[{'@type':'ListItem',position:2,name:'Music',item:absolute('/music/')}]:[]),{'@type':'ListItem',position:path.startsWith('/music/')&&path!=='/music/'?3:2,name:title.replace(' | SRY4U',''),item:canonical}]}]:[]),...schema];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#080a10"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{noindex&&<meta name="robots" content="noindex,follow"/>}<link rel="icon" type="image/png" href="/favicon.png"/><meta property="og:type" content="website"/><meta property="og:site_name" content="SRY4U"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={absolute(image)}/><meta property="og:image:alt" content={`${title} artwork`}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={absolute(image)}/>{markdown&&<link rel="alternate" type="text/markdown" href={absolute(markdown)} title="Markdown version"/>}<script type="application/ld+json" set:html={jsonLd({'@context':'https://schema.org','@graph':graph})}/><slot name="head"/></head><body data-analytics-id={site.analyticsId}><a href="#main" class="skip-link">Skip to content</a><Header/><main id="main"><slot/></main><Footer/><dialog id="privacy-dialog" class="privacy-dialog" aria-labelledby="privacy-title"><h2 id="privacy-title">Your privacy</h2><p>Essential preferences stay in this browser. Optional Google Analytics helps us understand which releases and shows you explore. It loads only if you allow it.</p><p>We do not send contact details or booking messages to analytics. Google may process usage data and device identifiers.</p><div class="button-group"><button class="button" data-analytics-choice="denied">Decline analytics</button><button class="button button-primary" data-analytics-choice="granted">Allow analytics</button></div><button class="text-button" data-privacy-close>Close</button></dialog><script src="../scripts/global.ts"></script></body></html>
