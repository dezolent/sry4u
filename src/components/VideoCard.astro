---
import SourceImage from './SourceImage.astro';
import {videoPath,videoThumbnail} from '../data/videos';
import type {Video} from '../data/videos';
interface Props {video:Video;index?:number;}
const {video,index=0}=Astro.props;
---
<article class="video-card">
 <a class="video-card-link" href={videoPath(video)}>
  <div class="video-art">
   <SourceImage src={videoThumbnail(video)} alt={`${video.title} — YouTube thumbnail`} width="640" height="360" sizes="(max-width: 700px) 90vw, 45vw" loading={index===0?'eager':'lazy'}/>
   <span class="video-play" aria-hidden="true">▶</span>
   <span class="video-duration">{video.duration}</span>
  </div>
  <div class="video-card-meta"><span>{video.kind}</span><time datetime={video.uploadDate}>{new Intl.DateTimeFormat('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'America/Los_Angeles'}).format(new Date(video.uploadDate))}</time></div>
  <h2>{video.title}</h2>
  <p>{video.description}</p>
  <span class="video-watch" aria-hidden="true">WATCH VIDEO ↗</span>
 </a>
</article>
<style>
 .video-card{min-width:0}.video-card-link{display:block;height:100%;padding-bottom:26px;border-bottom:1px solid #334359}
 .video-art{position:relative;aspect-ratio:16/9;overflow:hidden;border:1px solid #465970;background:#0d1521}
 .video-art img{width:100%;height:100%;object-fit:cover;transition:transform .3s}
 .video-card-link:hover img{transform:scale(1.03)}.video-play{position:absolute;inset:0;display:grid;place-items:center;font-size:30px;color:#fff;text-shadow:0 2px 20px #000}
 .video-duration{position:absolute;right:10px;bottom:10px;padding:3px 7px;background:#080a10e8;font:12px monospace;color:#fff}
 .video-card-meta{display:flex;justify-content:space-between;gap:12px;margin:18px 0 10px;font:10px monospace;letter-spacing:.06em;text-transform:uppercase;color:#adc4db}
 h2{font-size:clamp(20px,2.2vw,28px);letter-spacing:-.035em;line-height:1.25;margin-bottom:12px}
 p{font-size:14px;line-height:1.7;color:#b7c8da;max-width:55ch}.video-watch{display:block;margin-top:18px;font:11px monospace;letter-spacing:.08em;color:#9fe8ff}
 .video-card-link:hover h2{color:#9fe8ff}
 @media(prefers-reduced-motion:reduce){.video-art img{transition:none}}
</style>
