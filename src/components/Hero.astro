---
import SourceImage from './SourceImage.astro';
import '../styles/hero-channels.css';import {heroChannels} from '../data/hero-channels';
import {site} from '../data/site';import Socials from './Socials.astro';
---
<section class="hero" aria-label="SRY4U — emotional bass, nostalgia, release"><div class="hero-world" aria-hidden="true"><div class="hero-channel-feed">{heroChannels.map((channel,i)=><SourceImage class="hero-channel-image" style={`--channel-delay: ${-i*0.65}s`} src={`/images/branding-inspo/${channel.file}`} sizes="100vw" alt="" width="640" height="640" loading="eager" decoding="async" fetchpriority="low"/>)}</div><div class="hero-tracking"></div><div class="hero-static"></div><div class="hero-screen-edge"></div><SourceImage class="hero-ghost" src="/images/branding-inspo/sry4u-distorted-ghost.jpg" alt="" width="640" height="640"/><div class="hero-glow"></div><div class="hero-grid"></div></div><div class="hero-topline"><span>DENVER, COLORADO</span><span>WELCOME TO THE ATONEMENT</span><span class="signal"><i></i> SIGNAL FOUND</span></div><SourceImage class="hero-portrait" src="/images/brand/profile/sry4u-profile-main-cutout.png" sizes="(max-width: 700px) 90vw, 620px" alt="SRY4U in profile wearing a cap and hoodie" width="960" height="1440" loading="eager" fetchpriority="high"/><div class="hero-content"><h1><span class="sr-only">SRY4U — emotional bass, nostalgia, release</span><SourceImage src={site.chromeLogo} alt="" width="1026" height="392" loading="eager" fetchpriority="high" /></h1><p class="hero-tagline">FOR THE ONES WHO FEEL TOO MUCH.</p><Socials class="hero-socials"/></div><div class="hero-bottom"><p>EMOTIONAL BASS <span> / </span> NOSTALGIA <span> / </span> RELEASE</p><div class="button-group"><a class="button button-primary" href="#featured">Explore the music <span aria-hidden="true">↓</span></a><a class="button" href="#tour">Tour dates <span aria-hidden="true">↓</span></a></div></div><button class="motion-toggle" aria-pressed="false" type="button" data-motion-toggle>Pause motion</button><span class="hero-channel" aria-hidden="true">{heroChannels.map((channel,i)=><span class="hero-channel-label" style={`--channel-delay: ${-i*0.65}s`}>CH. {String(i+1).padStart(3,'0')} / {channel.label}</span>)}</span></section>
