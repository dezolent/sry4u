---
import SourceImage from './SourceImage.astro';
import {getImage} from 'astro:assets';import {imageSource} from '../lib/media';
const photos=await Promise.all(Array.from({length:8},async(_,i)=>{const id=i+1;const src=`/images/gallery/sry4-photo-gallery-${id}.${id===1?'png':'jpg'}`;const full=await getImage({src:imageSource(src),width:1600,format:'webp',quality:82});return {id,src,full:full.src,alt:`SRY4U artist photo ${id}`};}));
---
<section class="section gallery" id="gallery"><div class="section-heading"><div><p class="eyebrow">04 / THROUGH THE LENS</p><h2>IN THE <em>MOMENT.</em></h2></div><span class="section-note">08 FRAMES / ONE WORLD</span></div><div class="gallery-grid">{photos.map(photo=><button type="button" class="gallery-item" data-gallery-index={photo.id-1} data-full={photo.full} data-caption={photo.alt} aria-label={`Enlarge ${photo.alt}`}><SourceImage src={photo.src} sizes="(max-width: 600px) 45vw, (max-width: 1000px) 30vw, 23vw" alt={photo.alt} width="480" height="480" loading="lazy"/><span aria-hidden="true">{String(photo.id).padStart(2,'0')} <b>↗</b></span></button>)}</div><dialog id="gallery-dialog" class="gallery-dialog" aria-label="Artist photo gallery"><button class="lightbox-close" aria-label="Close photo" type="button">×</button><button class="lightbox-prev" aria-label="Previous photo" type="button">←</button><figure><img id="lightbox-image" alt=""/><figcaption id="lightbox-caption" aria-live="polite"></figcaption></figure><button class="lightbox-next" aria-label="Next photo" type="button">→</button></dialog></section><script src="../scripts/gallery.ts"></script>
