---
interface Props {top:string;bottom:string;}
const {top,bottom}=Astro.props;
---
<h1 class="signal-heading">
 <span class="signal-line">
  <span class="signal-label">{top}</span>
  <span class="signal-echo signal-cyan" aria-hidden="true">{top}</span>
  <span class="signal-echo signal-violet" aria-hidden="true">{top}</span>
 </span>
 <em class="signal-line signal-accent">
  <span class="signal-label">{bottom}</span>
  <span class="signal-echo signal-cyan" aria-hidden="true">{bottom}</span>
  <span class="signal-echo signal-violet" aria-hidden="true">{bottom}</span>
  <span class="signal-scan" aria-hidden="true"></span>
 </em>
</h1>
<style>
 .signal-heading{isolation:isolate}
 .signal-line{position:relative;display:block;width:fit-content;max-width:100%}
 .signal-label{display:block;animation:signal-arrive .85s cubic-bezier(.16,1,.3,1) both}
 .signal-accent{font-style:normal}.signal-accent .signal-label{animation-delay:.14s}
 .signal-echo{position:absolute;inset:0;display:block;pointer-events:none;opacity:0;user-select:none}
 .signal-cyan{color:#8ceaff;animation:signal-split-cyan 3.6s steps(1,end) .2s both}
 .signal-violet{color:#c2a4ff;animation:signal-split-violet 3.6s steps(1,end) .2s both}
 .signal-accent .signal-echo{animation-delay:.42s}
 .signal-scan{position:absolute;left:0;top:55%;height:2px;width:22%;background:#c9f6ff;box-shadow:0 0 16px #8ceaff;opacity:0;pointer-events:none;animation:signal-sweep 1.5s cubic-bezier(.16,1,.3,1) .45s both}
 @keyframes signal-arrive{
  from{transform:translateY(22px) skewX(-5deg);filter:blur(2px)}
  to{transform:none;filter:blur(0)}
 }
 @keyframes signal-split-cyan{
  0%,18%,39%,65%,100%{opacity:0;transform:none;clip-path:inset(0)}
  12%{opacity:.8;transform:translateX(-5px);clip-path:inset(18% 0 64% 0)}
  33%{opacity:.65;transform:translateX(4px);clip-path:inset(60% 0 21% 0)}
  59%{opacity:.75;transform:translateX(-3px);clip-path:inset(39% 0 43% 0)}
 }
 @keyframes signal-split-violet{
  0%,18%,39%,65%,100%{opacity:0;transform:none;clip-path:inset(0)}
  12%{opacity:.7;transform:translateX(5px);clip-path:inset(66% 0 16% 0)}
  33%{opacity:.6;transform:translateX(-4px);clip-path:inset(29% 0 52% 0)}
  59%{opacity:.65;transform:translateX(3px);clip-path:inset(70% 0 12% 0)}
 }
 @keyframes signal-sweep{
  0%{opacity:0;transform:translateX(0)}
  18%{opacity:.65}
  75%{opacity:.3}
  100%{opacity:0;transform:translateX(355%)}
 }
 @media(prefers-reduced-motion:reduce){
  .signal-label{animation:none;opacity:1;transform:none;filter:none}
  .signal-echo,.signal-scan{display:none;animation:none}
 }
</style>
