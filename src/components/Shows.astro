---
import 'dotenv/config';import {fetchEvents} from '../lib/events';import {eventSchema,jsonLd} from '../lib/structured';import {site} from '../data/site';
const feed=await fetchEvents({key:process.env.BANDSINTOWN_API_KEY});
---
<section class="section shows" id="tour" data-feed-status={feed.status} data-site-origin={site.origin}><div class="section-heading"><div><p class="eyebrow">02 / OUT IN THE WORLD</p><h2>LIVE. LOUD.<br class="mobile-break"/> <em>FELT.</em></h2></div><a class="text-link" href={site.bandsintown} target="_blank" rel="noopener noreferrer">Follow on Bandsintown <span aria-hidden="true">↗</span></a></div><div data-show-list>{feed.events.map(e=><article class="show-row" data-expires={e.expiresAt}><time datetime={e.date}><span>{new Date(e.date+'T12:00:00Z').toLocaleDateString('en-US',{month:'short',timeZone:'UTC'}).toUpperCase()}</span><strong>{e.date.slice(8,10)}</strong><small>{e.date.slice(0,4)}</small></time><div class="show-location"><h3>{[e.city,e.region].filter(Boolean).join(', ')}</h3><p>{e.venue}</p></div>{e.ticketUrl||e.url?<a class="button" href={e.ticketUrl||e.url} target="_blank" rel="noopener noreferrer" data-track="ticket_open">{e.ticketUrl?'Get tickets':'Event details'} <span aria-hidden="true">↗</span></a>:<p>Ticket details coming soon</p>}</article>)}</div><div class="shows-state" data-show-state hidden={feed.status==='ok'&&feed.events.length>0}><span class="state-symbol" aria-hidden="true">{feed.status==='ok'?'◎':'//'}</span><h3 data-show-message>{feed.status==='ok'?'The next chapter is coming.':'Show listings are temporarily unavailable.'}</h3><p data-show-help>{feed.status==='ok'?'No upcoming shows are listed right now. Follow SRY4U to hear when new dates drop.':'Check Bandsintown for the latest dates, or try again.'}</p><button type="button" class="text-button" data-show-retry hidden={feed.status==='ok'}>Try again</button></div><p class="feed-note" data-show-status role="status">Dates via Bandsintown · Updates automatically</p><noscript><p>For the latest changes, <a href={site.bandsintown}>view SRY4U on Bandsintown</a>.</p></noscript><script type="application/json" id="events-data" set:html={jsonLd(feed.events)}/><script type="application/ld+json" id="event-schema" set:html={jsonLd({'@context':'https://schema.org','@graph':feed.events.map(e=>eventSchema(e))})}/></section><script src="../scripts/shows.ts"></script>
