---
import SourceImage from '../../components/SourceImage.astro';
import Base from '../../layouts/Base.astro';import Services from '../../components/Services.astro';import Socials from '../../components/Socials.astro';import {songs} from '../../data/songs';import {cover} from '../../data/releases';import type {Song} from '../../data/types';import {songSchema} from '../../lib/structured';import {formatDate} from '../../lib/catalog';import {safePublicUrl} from '../../lib/events';
export function getStaticPaths(){return songs.map(song=>({params:{id:song.id},props:{song}}));}
interface Props {song:Song;}
const {song}=Astro.props;const description=`Listen to ${song.title} by ${song.artist||'SRY4U'}${song.collaborators?.length?` with ${song.collaborators.join(', ')}`:''}. Released ${formatDate(song.releaseDate)}. Find all available streaming services and downloads.`;
---
<Base title={`${song.title} | SRY4U`} description={description} schema={[songSchema(song)]} markdown={`/music/${song.id}.md`}><section class="section fanlink-section"><a class="back-link" href="/music/">← BACK TO THE DISCOGRAPHY</a><article class="fanlink-card"><header class="fanlink-head"><SourceImage class="fanlink-art" src={cover(song.id)} alt={`${song.title} cover artwork`} width="480" height="480" fetchpriority="high"/><p class="eyebrow">{song.artist||'SRY4U'}</p><h1>{song.title}</h1>{song.collaborators?.length&&<p class="fanlink-credits">With {song.collaborators.join(' · ')}</p>}{song.features?.length&&<p class="fanlink-credits">Featuring {song.features.join(' · ')}</p>}<div class="release-facts"><time datetime={song.releaseDate}>{formatDate(song.releaseDate)}</time><span>{song.duration}</span><span>{song.genres.join(' / ')}</span></div></header><Services links={song.streamingLinks}/>{safePublicUrl(song.freeDownload)&&<div class="fanlink-bottom"><a class="button" href={safePublicUrl(song.freeDownload)} target="_blank" rel="noopener noreferrer" data-track="download_open">Free download <span aria-hidden="true">↗</span></a><p>Opens the artist’s external download page.</p></div>}</article><Socials/><p class="fanlink-text"><a class="text-link" href={`/music/${song.id}.md`}>Read the text version</a></p></section></Base>
