---
import Base from '../../layouts/Base.astro';
import ReleaseCard from '../../components/ReleaseCard.astro';
import {releases,sortedSongs} from '../../data/releases';
import {albums} from '../../data/albums';
import {songSchema,albumSchema,absolute} from '../../lib/structured';

const eps=releases.filter(r=>r.category==='ep');
const songReleases=releases.filter(r=>r.category!=='ep');
const genres=[...new Set(songReleases.flatMap(r=>r.genres))].sort();
const years=[...new Set(songReleases.map(r=>r.releaseDate.slice(0,4)))].sort().reverse();
const schema=[...sortedSongs.map(songSchema),...albums.map(albumSchema),{'@type':'ItemList',name:'SRY4U discography',itemListElement:releases.map((r,i)=>({'@type':'ListItem',position:i+1,name:r.title,url:absolute(r.href)}))}];
---
<Base title="Music & Discography | SRY4U" description="Explore every SRY4U release, remix, EP, and Atonement mix. Search the catalog and find links to listen on Spotify, SoundCloud, and more." markdown="/music.md" schema={schema}>
  <section class="section page-intro">
    <p class="eyebrow">THE CATALOG / SRY4U</p>
    <h1>FEEL<br/><em>EVERYTHING.</em></h1>
    <p>Originals, flips, and confessions. Find your frequency.</p>
  </section>
  {eps.length>0&&<section id="ep-releases" class="section ep-section" aria-labelledby="ep-heading">
    <div class="section-heading"><h2 id="ep-heading">EPs</h2><p class="section-note">EXTENDED PLAYS / NEWEST FIRST</p></div>
    <div class="release-grid">{eps.map(release=><ReleaseCard release={release}/>)}</div>
  </section>}
  <section id="song-releases" class="section music-content" aria-labelledby="songs-heading">
    <div class="section-heading"><h2 id="songs-heading">SONGS</h2><p class="section-note">TRACKS, FLIPS &amp; MIXES</p></div>
    <form id="release-filters" class="filters" role="search" aria-label="Filter songs">
      <label>Search songs<input name="q" type="search" placeholder="Title, artist, collaborator…" autocomplete="off"/></label>
      <label>Genre<select name="genre"><option value="">All genres</option>{genres.map(g=><option value={g}>{g}</option>)}</select></label>
      <label>Year<select name="year"><option value="">All years</option>{years.map(y=><option value={y}>{y}</option>)}</select></label>
      <label>Release type<select name="category"><option value="">All songs &amp; mixes</option><option value="track">Tracks &amp; remixes</option><option value="mix">DJ mixes</option></select></label>
      <button class="text-button" type="button" data-clear-filters>Clear filters</button>
    </form>
    <noscript><p class="no-js-note">All songs are shown below. Enable JavaScript for search and filters.</p></noscript>
    <div class="results-info"><span id="release-count" role="status">{songReleases.length} songs</span><span>NEWEST FIRST / FIND YOUR FREQUENCY</span></div>
    <div class="release-grid">{songReleases.map(release=><ReleaseCard release={release} filterable/>)}</div>
    <div class="empty-results" id="empty-results" hidden><h2>No signal found.</h2><p>Try a different title, artist, or filter.</p><button class="text-button" type="button" data-clear-filters>Show all songs</button></div>
  </section>
</Base>
<script src="../../scripts/discography.ts"></script>
<style>
  .ep-section{padding-top:0;padding-bottom:72px}
  @media(max-width:800px){.ep-section{padding-bottom:48px}}
</style>
