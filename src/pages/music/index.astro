---
import SourceImage from '../../components/SourceImage.astro';
import Base from '../../layouts/Base.astro';import {releases,cover} from '../../data/releases';import {sortedSongs} from '../../data/releases';import {albums} from '../../data/albums';import {songSchema,albumSchema,absolute} from '../../lib/structured';import {formatDate} from '../../lib/catalog';
const genres=[...new Set(releases.flatMap(r=>r.genres))].sort();const years=[...new Set(releases.map(r=>r.releaseDate.slice(0,4)))].sort().reverse();
const schema=[...sortedSongs.map(songSchema),...albums.map(albumSchema),{'@type':'ItemList',name:'SRY4U discography',itemListElement:releases.map((r,i)=>({'@type':'ListItem',position:i+1,name:r.title,url:absolute(r.href)}))}];
---
<Base title="Music & Discography | SRY4U" description="Explore every SRY4U release, remix, EP, and Atonement mix. Search the catalog and find links to listen on Spotify, SoundCloud, and more." markdown="/music.md" schema={schema}><section class="section page-intro"><p class="eyebrow">THE CATALOG / SRY4U</p><h1>FEEL<br/><em>EVERYTHING.</em></h1><p>Originals, flips, and confessions. Find your frequency.</p></section><section class="section music-content" aria-label="Music discography"><form id="release-filters" class="filters" role="search"><label>Search releases<input name="q" type="search" placeholder="Title, artist, collaborator…" autocomplete="off" aria-label="Search releases"/></label><label>Genre<select name="genre"><option value="">All genres</option>{genres.map(g=><option value={g}>{g}</option>)}</select></label><label>Year<select name="year"><option value="">All years</option>{years.map(y=><option value={y}>{y}</option>)}</select></label><label>Release type<select name="category"><option value="">All releases</option><option value="track">Tracks &amp; remixes</option><option value="mix">DJ mixes</option><option value="ep">EPs</option></select></label><button class="text-button" type="button" data-clear-filters>Clear filters</button></form><noscript><p class="no-js-note">All releases are shown below. Enable JavaScript for search and filters.</p></noscript><div class="results-info"><span id="release-count" role="status">{releases.length} releases</span><span>NEWEST FIRST / FIND YOUR FREQUENCY</span></div><div class="release-grid">{releases.map(r=><article class="release-card" data-id={r.id} data-release={JSON.stringify(r)}><a class="art-link" href={r.href} aria-label={`Listen to ${r.title}`} data-track="release_open"><SourceImage src={cover(r.id)} sizes="(max-width: 800px) 43vw, (max-width: 1100px) 30vw, 280px" alt={`${r.title} cover artwork`} width="480" height="480" loading="lazy"/><span class="release-category">{r.category==='ep'?'EP':r.category==='mix'?'DJ MIX':'TRACK / FLIP'}</span></a><h2><a href={r.href}>{r.title}</a></h2><p>{r.artist||'SRY4U'}{'collaborators' in r&&r.collaborators?.length?` · ${r.collaborators.join(', ')}`:''}</p><p class="release-date"><time datetime={r.releaseDate}>{formatDate(r.releaseDate)}</time><span>{r.duration}</span></p></article>)}</div><div class="empty-results" id="empty-results" hidden><h2>No signal found.</h2><p>Try a different title, artist, or filter.</p><button class="text-button" type="button" data-clear-filters>Show all releases</button></div></section></Base><script src="../../scripts/discography.ts"></script>
