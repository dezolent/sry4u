---
import SourceImage from '../components/SourceImage.astro';
import Base from '../layouts/Base.astro';import Hero from '../components/Hero.astro';import Shows from '../components/Shows.astro';import Tracklist from '../components/Tracklist.astro';import Gallery from '../components/Gallery.astro';import About from '../components/About.astro';import {sortedSongs} from '../data/releases';import {site} from '../data/site';import {contactEmail} from '../data/socials';import {safePublicUrl} from '../lib/events';import {songSchema} from '../lib/structured';
const merch=safePublicUrl(site.merchUrl);
---
<Base title="SRY4U | Emotional Bass. Nostalgia. Release." markdown="/index.md"
      schema={sortedSongs.slice(0, 10).map(songSchema)}>
    <Hero/>
    <Shows/>
    <section class="section featured" id="featured">
        <div class="section-heading">
            <div><p class="eyebrow">03 / THE LATEST TRANSMISSIONS</p>
                <h2>FEATURED<br/><em>RELEASES.</em></h2></div>
            <a class="text-link" href="/music/">View all music <span aria-hidden="true">↗</span></a></div>
        <Tracklist songs={sortedSongs.slice(0, 10)} newTab/>
    </section>
    <Gallery/>
    <About/>
    <section class="section merch" aria-labelledby="merch-title">
        <SourceImage src="/images/brand/emblem/Sry4u EMBLEM 3 (COLOR).png" alt="SRY4U emblem" width="220" height="220"
                     loading="lazy"/>
        <div><p class="eyebrow">TAKE THE WORLD WITH YOU</p>
            <h2 id="merch-title">WEAR THE<br/><em>FEELING.</em></h2>
            <p>{merch ? 'Official SRY4U merchandise. Explore the collection.' : 'Interested in SRY4U merch? Get in touch for availability and future drops.'}</p>
        </div>
        <a class="button" href={merch || `mailto:${contactEmail}?subject=SRY4U%20merchandise`}
           target={merch ? '_blank' : undefined}
           rel={merch ? 'noopener noreferrer' : undefined}>{merch ? 'Shop merch' : 'Ask about merch'} <span
                aria-hidden="true">↗</span></a></section>
</Base>
