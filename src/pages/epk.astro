---
import SourceImage from '../components/SourceImage.astro';
import Base from '../layouts/Base.astro';import Contact from '../components/Contact.astro';import {site} from '../data/site';import {biography,atonement,metrics,markets,reportingPeriod,liveSupport,artistSupport} from '../data/artist';
---
<Base title="Electronic Press Kit | SRY4U" description="SRY4U's 2026 electronic press kit: Denver-based emotional bass and dubstep artist, live support credits, audience momentum, press photos, and booking contacts." markdown="/epk.md"><section class="epk-hero"><SourceImage src="/images/brand/press-photos/sry4u-press-photo-1.jpg" alt="SRY4U press portrait" width="1280" height="900" fetchpriority="high"/><div class="section"><p class="eyebrow">DENVER // COLORADO — ELECTRONIC PRESS KIT / 2026</p><h1>SRY4U</h1><p>EMOTIONAL BASS // NOSTALGIA // RELEASE</p><div class="button-group"><a class="button button-primary" href={site.pdf} download="SRY4U_EPK_2026.pdf">Download EPK <span aria-hidden="true">↓</span></a><a class="button" href="#epk-contact">Booking &amp; contact</a></div></div></section><section class="section epk-profile"><div><p class="eyebrow">02 // ARTIST PROFILE</p><h2>BUILT ON<br/><em>CONTRAST.</em></h2><div class="body-copy">{biography.map(p=><p>{p}</p>)}</div><h3>ATONEMENT</h3><div class="body-copy"><p>{atonement}</p></div><blockquote class="quote">THIS ISN’T ABOUT ESCAPING WHAT YOU FEEL.<br/>IT’S ABOUT TURNING IT UP.</blockquote></div><SourceImage class="epk-photo" src="/images/gallery/sry4-photo-gallery-1.png" alt="SRY4U live performance photo" width="640" height="900" loading="lazy"/></section><section class="section epk-momentum"><div class="section-heading"><div><p class="eyebrow">03 // MOMENTUM</p><h2>SOUND<em>CLOUD.</em></h2></div><p class="section-note">LAST 12 MONTHS // {reportingPeriod.toUpperCase()}</p></div><p>Source: artist-supplied 2026 EPK · {reportingPeriod}. Historical figures.</p><div class="metrics-layout"><div class="metrics-grid">{metrics.map(m=><div class="metric"><strong>{m.value}</strong><span>{m.label}</span></div>)}</div><div><h3>TOP LISTENER MARKETS</h3><ul class="market-list">{markets.map(([name,value])=><li><span>{name}</span><span>{value}</span></li>)}</ul><p class="feed-note">DENVER IS THE #1 SOUNDCLOUD MARKET.</p></div></div></section><section class="section epk-live" id="epk-contact"><div><p class="eyebrow">04 // LIVE &amp; CONTACT</p><h2>LIVE. LOUD.<br/><em>FELT.</em></h2><h3>Select live support</h3><p class="support-list">{liveSupport.join(' // ')}</p><h3>Artist support</h3><p class="support-list">{artistSupport.join(' // ')}</p></div><div><p class="eyebrow">BOOKING / CONNECTIONS / PRESS</p><Contact/><p class="body-copy">Press photos and brand assets are available below. For booking enquiries, reach out directly.</p><a class="text-link" href={site.pdf} download="SRY4U_EPK_2026.pdf">Download the original PDF <span aria-hidden="true">↓</span></a></div></section><section class="section epk-assets"><p class="eyebrow">PRESS-READY / ARTIST PHOTOGRAPHY</p><h2>PRESS <em>PHOTOS.</em></h2><div class="press-grid">{Array.from({length:5},(_,i)=>i+1).map(i=><a href={`/images/brand/press-photos/sry4u-press-photo-${i}.jpg`} download={`SRY4U-press-photo-${i}.jpg`}><SourceImage src={`/images/brand/press-photos/sry4u-press-photo-${i}.jpg`} alt={`SRY4U press photograph ${i}`} width="640" height="850" loading="lazy"/><span>PHOTO {String(i).padStart(2,'0')} / DOWNLOAD ↗</span></a>)}</div></section></Base>
