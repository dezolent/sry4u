{
  "name": "sry4u-artist-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --ignore-lock",
    "check": "astro check",
    "build": "astro build && node scripts/finalize-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "covers": "node --experimental-strip-types scripts/sync-covers.mjs",
    "verify:build": "node --experimental-strip-types scripts/verify-build.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.6",
    "dotenv": "^18.0.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "typescript": "^6.0.3"
  }
}
